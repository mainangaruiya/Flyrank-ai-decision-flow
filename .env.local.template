# Copy to .env.local and fill in your keys.
# Either provider works on its own - whichever is primary is tried first, and the
# other one answers if it fails. Set at least one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider to try first: anthropic (default) or openai
LLM_PROVIDER=anthropic

# Models used by each provider
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
